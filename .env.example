# ==============================================================================
# TELEGRAM USERBOT (LISTENER) CONFIGURATION
# ==============================================================================
# 1. Go to https://my.telegram.org and log in with your phone number.
# 2. Click "API development tools" to get your API ID and API HASH.
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here

# The phone number of your Telegram account running the listener (e.g. +1234567890)
TELEGRAM_PHONE=+1234567890

# The target chat ID or username of your private chat with Anna to monitor
# (Can be a numeric chat ID, @username, or phone number)
TELEGRAM_TARGET_CHAT=your_chat_with_anna

# ==============================================================================
# TELEGRAM REPORTER BOT CONFIGURATION
# ==============================================================================
# 1. Open Telegram and search for @BotFather.
# 2. Send /newbot, give it a name, and copy the HTTP API token below.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Comma-separated list of Telegram User IDs that will receive reports and prompts.
# (Both you and Anna must open the bot and press /start once to allow incoming DMs)
# You can find your user ID by sending a message to @userinfobot on Telegram.
TELEGRAM_NOTIFY_CHAT_IDS=123456789,987654321

# ==============================================================================
# SPOTIFY WEB API CONFIGURATION
# ==============================================================================
# 1. Go to https://developer.spotify.com/dashboard and log in.
# 2. Click "Create App", name it (e.g., "Anna & I Auto Sync"), set Redirect URI:
#    http://127.0.0.1:8888/callback
# 3. Copy your Client ID and Client Secret below.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# The Target Spotify Playlist ID:
# Open your playlist in Spotify -> Share -> Copy link (e.g., open.spotify.com/playlist/37i9dQZF1DXc7FZ2VBjaeT)
# The Playlist ID is the code between /playlist/ and ? (e.g. 37i9dQZF1DXc7FZ2VBjaeT)
SPOTIFY_PLAYLIST_ID=your_spotify_playlist_id

# ==============================================================================
# PATHS & STORAGE
# ==============================================================================
LINKS_FILE_PATH=spotify_links.txt
DB_FILE_PATH=sync_history.db
